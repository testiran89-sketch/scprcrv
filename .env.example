# Network / wallet
RPC_URL=https://your-rpc-url
PRIVATE_KEY=0xyourprivatekey
CHAIN=ethereum

# Scanner base/quotes (USDC-centric example for Polygon)
BASE_SYMBOL=CRV
QUOTE_SYMBOLS=WETH,USDC,USDT,DAI,FRAX,cvxCRV

# Deployed CrvFlashArb contract address
FLASH_ARB_CONTRACT=0xYourDeployedContract

# Execution controls
MIN_SPREAD_PCT=0.3
LOAN_USD=100000
# For non-stable quote pairs like CRV/WETH set this (e.g. LOAN_QUOTE=20)
# LOAN_QUOTE=20
# Use only up to X bps of min(buyPoolLiquidity, sellPoolLiquidity)
LOAN_UTILIZATION_BPS=500
# Skip opportunities where either side pool liquidity is below this
MIN_POOL_LIQUIDITY_USD=10000
# Minimum profit filters
MIN_PROFIT_BPS=0
# MIN_PROFIT_QUOTE=5
VERBOSE=false
MAX_OPPS=3
DRY_RUN=true
